{
  "framework": null,
  "rewrites": [
    { "source": "/((?!cosmos-studios(?:/|$)).*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/cosmos-studios/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
